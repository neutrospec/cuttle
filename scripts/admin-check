#!/bin/sh
# Runs the headless Chrome admin checks: design 0005 A10, the T2 check
# at M2 close (design 0007 D7), and the browser check of the admin shell,
# visual system, and script of design 0009 (D2, D10, D11).
#
# TestAdminChrome builds cuttle, serves it with temporary XDG directories
# and test-chosen loopback ports, and drives headless Chrome through
# sign-in and every page, also at 390 px in light and dark appearance.
# TestAdminScreens serves the admin pages with example traffic and state
# and checks each page at 1280 and 390 px in both appearances, the
# script's controls, the review dialog and apply, the file banners, the
# previous version, and the pages without the script.
# TestAdminScreensSettings does the same for the Interfaces, Proxy,
# Remote clients, General, and Account pages and drives their flows with
# and without the script. All three use a throwaway profile and the mock
# keychain; Chrome opens no window and no debugging port, and its only
# proxy is a listener that refuses every request.
#
#   scripts/admin-check
#
# CUTTLE_CHROME overrides the Chrome binary, and CUTTLE_ADMIN_CHROME_OUT
# names an existing directory for screenshots of each page.
set -eu

cd "$(dirname "$0")/.."
set -x
CUTTLE_ADMIN_CHROME=1 go test -count=1 -v -run '^TestAdminChrome$' ./cmd/cuttle
CUTTLE_ADMIN_CHROME=1 go test -count=1 -v -run '^TestAdminScreens$' ./internal/admin
CUTTLE_ADMIN_CHROME=1 go test -count=1 -v -run '^TestAdminScreensSettings$' ./internal/admin
{ set +x; } 2>/dev/null
# Only this check's processes: the binary under cuttle-bin-* and Chrome
# with a throwaway profile under a test's temporary directory.
pids=$(/usr/bin/pgrep -f 'cuttle-bin-|TestAdminChrome|TestAdminScreens' || true)
if [ -n "$pids" ]; then
	echo "admin-check: processes left: $pids" >&2
	exit 1
fi
echo "admin-check: pass"
