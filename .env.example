# Local values for the real-environment checks. Copy this file to .env at
# the repository root and replace each value; Git ignores .env. Host names,
# domains, and the URL use reserved example names, addresses use RFC 5737
# documentation ranges, and the CA path and scan patterns are labelled
# placeholders. The ports are ordinary example values. Never commit real
# values.

# Egress proxy host. OI-0001 steps 2 and 3: the gateway's "egress"
# upstream and `openssl s_client -proxy`.
CUTTLE_EGRESS_PROXY_HOST=proxy.internal.example

# Egress proxy port. OI-0001 steps 2 and 3: the gateway's "egress"
# upstream and `openssl s_client -proxy`.
CUTTLE_EGRESS_PROXY_PORT=8080

# Gateway instance's private-link address. OI-0001 steps 1, 2, and 4: the
# gateway listener and the edge's "gateway" upstream.
CUTTLE_GATEWAY_LINK_ADDRESS=198.51.100.6

# Gateway instance's private-link port. OI-0001 steps 1, 2, and 4: the
# gateway listener and the edge's "gateway" upstream.
CUTTLE_GATEWAY_LINK_PORT=3128

# Source address the gateway instance is expected to see from the edge
# side. OI-0001 step 1: the value for `proxy.remote.sources`.
CUTTLE_GATEWAY_EXPECTED_SOURCE=198.51.100.2

# Comma-separated restricted domains routed through the chain. OI-0001
# steps 1 and 2: the edge and gateway "restricted" rules.
CUTTLE_RESTRICTED_DOMAINS=internal.example,intranet.example.net

# One restricted destination to load through the chain. OI-0001 steps 1
# to 3: curl, Chrome, and `openssl s_client -connect`.
CUTTLE_RESTRICTED_URL=https://wiki.internal.example/

# Path to the egress proxy's inspection root CA certificate (PEM). OI-0001
# step 2: `curl --cacert` for restricted destinations through the chain.
CUTTLE_INSPECTION_ROOT_CA=/path/to/inspection-root.pem

# Publication scan patterns. OI-0004 rule 5: one extended regular
# expression, matched case-insensitively, joining with `|` the local
# username, scratch and tool directory paths, private project names, local
# time-zone markers, and foreign commit IDs. Keep the single quotes. Bound
# short tokens with `(^|[^[:alnum:]])` and `([^[:alnum:]]|$)`, because a
# case-insensitive match also finds them inside words.
CUTTLE_PUBLISH_SCAN_PATTERNS='<pattern-1>|<pattern-2>'
